# Copiá este archivo como .env y completá los valores.

# Puerto y dirección del servidor
PORT=3000
HOST=0.0.0.0

# Usuario administrador que se crea la PRIMERA vez que arranca el sistema (base vacía).
# Si no definís ADMIN_PASSWORD se genera una contraseña aleatoria y se muestra en la consola.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Poné 1 si el sitio corre detrás de un proxy/CDN (Nginx, Render, Railway, Cloudflare...)
TRUST_PROXY=0

# Cookies de sesión solo por HTTPS: auto | 1 | 0
COOKIE_SECURE=auto

# Carpetas de datos (opcional). Usá un disco persistente en producción.
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
